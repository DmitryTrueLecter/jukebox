# Copy to .env and fill in. .env is gitignored.
JUKEBOX_HOST=jukebox.local
JUKEBOX_USER=jukebox
# Used for SSH (if no key is installed) and for sudo on the Pi. Leave empty with key auth + passwordless sudo.
JUKEBOX_PASSWORD=
JUKEBOX_APP_DIR=/home/jukebox/jukebox-manager
JUKEBOX_DATA_DIR=/home/jukebox/jukebox-data
JUKEBOX_PORT=8080
JUKEBOX_KEEP_RELEASES=5
